# Copie este arquivo para .env e preencha os valores.
# Nunca envie o .env para o GitHub. Os valores reais vão por mensagem privada.
# No Render, cadastre as mesmas variáveis no painel do serviço.

# local mostra erros na tela; production só registra em log.
APP_ENV=local

# Supabase: copie do botão Connect, opção Transaction pooler.
# O usuário tem o formato postgres.<ref-do-projeto>.
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASS=

# Gemini: chave e modelo conferidos no Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
