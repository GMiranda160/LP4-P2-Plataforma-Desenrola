# Copie este arquivo para .env e preencha os valores.
# Nunca envie o .env para o GitHub. Os valores reais vão por mensagem privada.
# No Railway, cadastre as mesmas variáveis no painel do serviço.

# local mostra erros na tela; production só registra em log.
APP_ENV=local

# Supabase: copie do botão Connect, opção Transaction pooler.
# O usuário tem o formato postgres.<ref-do-projeto>.
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASS=

# Gemini: chave e modelo conferidos no Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Opcional: modelo de contingencia se o padrao falhar.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Supabase Storage: Project Settings -> API. URL publica do projeto e service role (secreta).
# Usado para upload da imagem final e dos produtos base quando a migracao for aprovada.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
